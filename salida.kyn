// Codigo Andante generado por andante (Grupo 6) desde andante.and

// Traduccion automatica de Andante a Kynova (.kyn)
splice plasmid Personaje = "";
splice adam estrellas = 0;
splice eve tiempo = 0.00;
// Archivo de prueba completo con operadores binarios y paréntesis (valido3.sa)
Personaje = "Peach";
estrellas = 20;
tiempo = 45.50;
radio(estrellas);
atlas (estrellas >= 20) {
    tiempo = (tiempo - 5.50) * 2;
} ryan atlas (estrellas > 10) {
    estrellas = (estrellas + 10) / 2;
} ryan {
    estrellas = 100 - (25 * 2);
}
diary(Personaje);
diary(tiempo);
vita (estrellas < 25) {
    estrellas = estrellas + (1 + 2);
}
/*
    Cubre declaraciones, lectura, condicionales, ciclo mientras,
    salida y operaciones aritméticas (+, -, *, /) con paréntesis.
*/

